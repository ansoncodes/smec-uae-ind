# Copy to .env.local for development, and set these per environment when
# deploying. Nothing here has a safe production default — the values are
# SMEC's to provide (docs/spec-alignment.md, section 0).

# The public origin. Every canonical, sitemap entry, schema @id and OG URL is
# built from it, so it must be the real domain in production (0.1).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 'production' hides the "draft · not indexed" badge on gated pages.
NEXT_PUBLIC_SITE_ENV=development

# Where the RFQ form posts. The lead API and the campaign key that identifies
# this site to it (0.4). LEAD_API_KEY has no NEXT_PUBLIC_ prefix on purpose:
# it stays on the server and is never bundled into client JavaScript, which
# the Technical SEO Master §20 requires.
LEAD_API_URL=https://api.smec.in
LEAD_API_KEY=

# Only set this if the site is hosted without a Node runtime and the form has
# to post to the lead API directly. Doing so makes the campaign key public and
# loses the server-side validation and rate limiting in app/api/rfq/route.ts.
# NEXT_PUBLIC_RFQ_ENDPOINT=/api/rfq/

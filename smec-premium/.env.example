# Copy to .env.local for development, and set these per environment when
# deploying. Nothing here has a safe production default — the values are
# SMEC's to provide (docs/spec-alignment.md, section 0).

# The public origin. Every canonical, sitemap entry, schema @id and OG URL is
# built from it.
#
# Production is https://smecoilandgas.com (confirmed) — the same domain the
# current WordPress site is on, so this is a replacement rather than a move.
# The redirect map in lib/redirects.mjs is therefore live from the first
# request: this build serves the paths the old site serves.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 'production' hides the "draft · not indexed" badge on gated pages.
NEXT_PUBLIC_SITE_ENV=development

# Analytics, as SMEC sent them on 25 Sep for smecoilandgas.com. Set these in
# production only: left unset, nothing is loaded, so previews and local builds
# never report into SMEC's property. Either way nothing loads until a visitor
# accepts the consent banner (lib/tags.ts).
#
#   NEXT_PUBLIC_GTM_ID=GTM-P4HFZ66X
#   NEXT_PUBLIC_GA4_ID=G-VKLSH1HQBX
#
# If SMEC's container also holds a GA4 tag for G-VKLSH1HQBX, leave
# NEXT_PUBLIC_GA4_ID unset, or every page view is counted twice (audit ANA-07).
# Clarity has no variable: the container loads it.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# Where the RFQ form posts. The lead API and the campaign key that identifies
# this site to it (0.4). LEAD_API_KEY has no NEXT_PUBLIC_ prefix on purpose:
# it stays on the server and is never bundled into client JavaScript, which
# the Technical SEO Master §20 requires.
LEAD_API_URL=https://api.smec.in
LEAD_API_KEY=

# The RFQ form's region choice picks a campaign key per team, each falling
# back to LEAD_API_KEY (app/api/rfq/route.ts). Set LEAD_API_KEY_INDIA once the
# India campaign exists in the lead system; until then both regions arrive in
# one campaign, labelled by region.
LEAD_API_KEY_UAE=
LEAD_API_KEY_INDIA=

# The SMEC EDGE newsletter signs visitors up through Mailchimp's double
# opt-in (lib/newsletter.ts). The section stays off the page until both are
# set at build time. The key ends in its data centre ("…-us21").
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Optional: the API host, if it is not the key's data centre.
# MAILCHIMP_API_BASE=

# IndexNow: the key served at /<key>.txt, used by `npm run indexnow` after
# launch to tell Bing and others which URLs changed.
INDEXNOW_KEY=

# Only set this if the site is hosted without a Node runtime and the form has
# to post to the lead API directly. Doing so makes the campaign key public and
# loses the server-side validation and rate limiting in app/api/rfq/route.ts.
# NEXT_PUBLIC_RFQ_ENDPOINT=/api/rfq/
